APP_NAME="FasTicket FastAPI Backend"
APP_ENV=local

# Own dedicated Postgres database, separate from the Laravel backend's database
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/fasticket_fastapi

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1024
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

CORS_ALLOWED_ORIGINS=["*"]

# Used by both the API (to enqueue jobs) and the arq worker (to process them)
REDIS_URL=redis://127.0.0.1:6379/0

# SMTP credentials for the password-reset email — fill in a real provider (Mailtrap, SES, Postmark, etc.)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=no-reply@fasticket.test
MAIL_FROM_NAME="FasTicket"

# Base URL of the frontend app — used to build the reset-password link
FRONTEND_URL=http://localhost:3000

# S3 bucket used for signed upload/download URLs (profile avatars, etc.)
# Leave the key/secret blank to fall back to boto3's default credential chain (IAM role, ~/.aws, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ROOT=dev
AWS_BUCKET=dev-fasticket-public
AWS_BUCKET_PRIVATE=dev-fasticket-private

# Only set this for an S3-compatible service (e.g. MinIO, LocalStack) — leave blank for real AWS S3
S3_ENDPOINT_URL=
PRESIGNED_UPLOAD_URL_EXPIRE_SECONDS=300
PRESIGNED_DOWNLOAD_URL_EXPIRE_SECONDS=3600
